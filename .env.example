# ---------------------------------------------------------------------------
# Max ERP - root environment for docker-compose
# Copy to `.env` and adjust as needed before running `docker compose up`.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=maxerp
POSTGRES_PASSWORD=maxerp
POSTGRES_DB=maxerp

# Backend (FastAPI)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ROOT_USERNAME=root
ROOT_EMAIL=root@maxerp.com
ROOT_PASSWORD=root12345

# Frontend (Auth.js)
AUTH_SECRET=change-me-to-a-long-random-secret
