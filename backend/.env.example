# ---------------------------------------------------------------------------
# Max ERP backend configuration
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

APP_NAME="Max ERP API"
APP_VERSION="0.1.0"
DEBUG=false
API_V1_PREFIX="/api/v1"

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://maxerp:maxerp@localhost:5432/maxerp

# JWT / auth
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Seed root account (created automatically on first startup)
ROOT_USERNAME=root
ROOT_EMAIL=root@maxerp.com
ROOT_PASSWORD=root12345

# CORS - comma separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]
