# ---------------------------------------------------------------------------
# Max ERP frontend configuration
# Copy this file to `.env.local` (or set these in your environment).
# ---------------------------------------------------------------------------

# Auth.js secret - generate with `openssl rand -base64 32`
AUTH_SECRET=replace-with-a-long-random-secret

# Trusted Auth.js host (used when deploying behind a proxy)
# AUTH_TRUST_HOST=true

# Backend API base URL (used server-side by Auth.js)
BACKEND_URL=http://localhost:8000

# Backend API base URL exposed to the browser (used for direct client calls)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
